def kaprekar(num):
    s=0
    while not num==6174:
        n=[i for i in str(num)]
        j=sorted(n)
        j=''.join(j)
        small=int(j)

        k=sorted(n,reverse=True)
        k=''.join(k)
        large=int(k)

        num=large-small

        s+=1
    return s

