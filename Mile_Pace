def mile_pace(miles, duration):
    mins=int(duration.split(":")[0])
    secs=int(duration.split(":")[1])
    total_sec=int((mins*60+secs)/miles)
    pace_m=total_sec//60
    pace_s=total_sec%60
    return f"{pace_m:02d}:{pace_s:02d}"

