def find_signal(grid):
    row=len(grid)
    col=len(grid[0])
    cell=[]
    for i in range(row):
        for j in range(col):
            if grid[i][j]>0:
                cell.append([i,j,grid[i][j]])

    for i in range(row):
        for j in range(col):
            k=True
            for r,c,d in cell:
                dist=max(abs(r-i),abs(c-j))
                if dist!=d:
                    k=False
                    break
            if k:
                return [i,j]

