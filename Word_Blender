def blend_words(word1, word2):
    i=len(word1)/2
    j=len(word2)/2
    if str(i).split(".")[1]=="0":
        end=int(i)
        first=word1[:end]
    else:
        end=int(i-0.5)
        first=word1[:end]
    if str(j).split(".")[1]=="0":
        start=int(j)
        second=word2[start:]
    else:
        start=int(j-0.5)
        second=word2[start:]
    return first+second
