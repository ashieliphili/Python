import string
def letter_distance(str1, str2):
    s1=[i for i in str1]
    s2=[j for j in str2]
    alphabet = string.ascii_lowercase
    
    sum12=0
    for i in range(len(s1)):
        k=abs(alphabet.index(s1[i])-alphabet.index(s2[i]))
        g=26-k
        sum12+=min(g,k)
    return sum12

