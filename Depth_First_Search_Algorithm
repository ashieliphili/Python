def dfs(mat,node):
    visited=[]
    result=[node]

    while result:
        current=result.pop()
        if current not in visited:
            visited.append(current)
        
        for i in range(len(mat)):
            if mat[current][i]==1 and i not in visited:
               result.append(i) 
    return visited

