def is_golden_ratio(a, b):
    maxi=max(a,b)
    mini=min(a,b)

    golden_ratio=1.618
    tolerance=0.01
    x=golden_ratio-tolerance
    y=golden_ratio+tolerance
    val=round(maxi/mini,3)

    if x<=val<=y:
        return True
    else:
        return False

