def decode_morse(code):
    codes={".-":"A",	"-...":"B", "-.-.":"C", "-..":"D", ".":"E", "..-.":"F", "--.":"G", "....":"H","..":"I", ".---":"J", "-.-":"K", ".-..":"L", "-.":"N", "--":"M", "---":"O", ".--.":"P", "--.-":"Q", ".-.":"R", "...":"S", "-":"T", "..-":"U", "...-":"V", ".--":"W", "-..-":"X", "-.--":"Y", "--..":"Z"}
    res=[]
    words=code.split("   ")
    for i in words:
        w=""
        letter=i.split(" ")
        for j in letter:
            w+=codes[j]
        w=''.join(w)
        res.append(w)
        if i!=words[-1]:
            res.append(" ")
    return ''.join(res) 

