def evaluate(numbers, operators):
    curr=numbers[0]
    for i in range(1,len(numbers)):
        op=operators[(i-1)%len(operators)]
        nex=numbers[i]

        if op=="+":
            curr+=nex
        elif op=="-":
            curr-=nex
        elif op=="*":
            curr*=nex
        elif op=="/":
            curr/=nex
        elif op=="%":
            curr%=nex
    return curr

