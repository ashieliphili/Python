def hanoi_solver(num):
    l=[]
    m=[]
    r=[]
    for i in range(num,0,-1):
        l.append(i)
    res=f"{l} {m} {r}\n"

    def move(n,start,end,inter):
        nonlocal res
        if n==1:
            end.append(start.pop())
            res+=f"{l} {m} {r}\n"
        else:
            move(n-1,start,inter,end)
            end.append(start.pop())
            res+=f"{l} {m} {r}\n"
            move(n-1,inter,end,start)

    move(num,l,r,m)
    return res.strip()

