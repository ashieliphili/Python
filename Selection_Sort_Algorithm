def selection_sort(item):
    if len(item)<=1:
        return item
    else:
        for i in range(len(item)):
            mini=min(item[i:len(item)])
            ind=item.index(mini,i)
            if mini!=item[i]:
                item[ind]=item[i]
                item[i]=mini
            else:
                continue
    return item

