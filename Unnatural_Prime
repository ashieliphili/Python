def is_unnatural_prime(n):
    if n==1 or n==-1 or n==0:
        check=False
    elif abs(n)>1:
        check=True
        for i in range(2,abs(n)+1):
            if abs(n)%i==0 and abs(n)!=i:
                check=False
                break
    if check:
        return check
    else:
        return check

