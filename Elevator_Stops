def elevator_stops(current_floor, stops):
    stops=sorted(stops)
    route=[]
    below=[i for i in stops if i<current_floor]
    above=[i for i in stops if i>current_floor]

    if below==[]:
        route.extend(above)
    elif above==[]:
        route.extend(sorted(below,reverse=True))
    elif current_floor-below[-1]==above[0]-current_floor:
        if current_floor-below[-2]<above[1]-current_floor:
            route.extend(sorted(below,reverse=True))
            route.extend(above)
        else:
            route.extend(above)
            route.extend(sorted(below,reverse=True))
    elif current_floor-below[-1]<above[0]-current_floor:
        route.extend(sorted(below,reverse=True))
        route.extend(above)
    elif current_floor-below[-1]>above[0]-current_floor:
        route.extend(above)
        route.extend(sorted(below,reverse=True))
    return route

