def dfs_n_queens(n):
    result=[]
    if n<1:
        return result

    def trace(row,comb,col,dia1,dia2):
        if row==n:
            result.append(list(comb))

        for i in range(n):
            if i in col or (row-i) in dia1 or (row+i) in dia2:
                continue

            col.add(i)
            dia1.add(row-i)
            dia2.add(row+i)
            comb.append(i)

            trace(row+1,comb,col,dia1,dia2)

            col.remove(i)
            dia1.remove(row-i)
            dia2.remove(row+i)
            comb.pop()

    trace(0,[],set(),set(),set())
    return result

