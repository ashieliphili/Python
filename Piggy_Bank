def piggy_bank(coins):
    value={"pennies": 0.01, "nickels": 0.05, "dimes": 0.10, "quarters": 0.25}
    if coins=={}:
        return "$0.00"
    else:
        summ=0
        for k, val in coins.items():
            if k in value.keys():
                summ+=val*value[k]
        sum_str="$"+str(round(summ,2))
        return sum_str

