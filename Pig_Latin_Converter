def pig_latin(s):
    vowel="aeiouAEIOU"
    lis=[]
    for i in s.split():
        if i[0] in vowel:
            lis.append(i+"way")
        else:
            d=0
            for m in i:
                if m in vowel:
                    break
                d+=1
            new=i[d:]+i[:d]+"ay"
            if i[0].isupper():
                new=new.lower().capitalize()
            lis.append(new)
    lis=' '.join(lis)
    return lis

