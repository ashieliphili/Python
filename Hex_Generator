import random
def generate_hex(color):
    if color not in ["red","green","blue"]:
        return "Invalid color"
    dom_val=random.randint(2,255)
    sec1_val=random.randint(0,dom_val-1)
    sec2_val=random.randint(0,dom_val-1)

    if color=="red":
        r,g,b=dom_val,sec1_val,sec2_val
    elif color=="green":
        r,g,b=sec1_val,dom_val,sec2_val
    elif color=="blue":
        r,g,b=sec1_val,sec2_val,dom_val

    return f"{r:02X}{g:02X}{b:02X}"

