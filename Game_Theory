def play_game(p1, p2):
    p1_score=0
    p2_score=0
    i=[m for m in p1]
    j=[m for m in p2]
    for q in range(len(i)):
        if i[q]==j[q]:
            if i[q]=="C":
                p1_score+=3
                p2_score+=3
            elif i[q]=="D":
                p1_score+=1
                p2_score+=1
        else:
            if i[q]=="C" and j[q]=="D":
                p1_score+=0
                p2_score+=5
            else:
                p1_score+=5
                p2_score+=0 
    return [p1_score,p2_score]

