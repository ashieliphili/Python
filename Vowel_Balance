def is_balanced(s):
    vowel="aeiouAEIOU"
    first=0
    second=0
    if len(s)%2==0:
        r=int(len(s)/2)
        for i in s[:r-1]:
            if i in vowel:
                first+=1
        for i in s[r-1:]:
            if i in vowel:
                second+=1
    else:
        r=int((len(s)/2)+0.5)
        for i in s[:r-1]:
            if i in vowel:
                first+=1
        for i in s[r:]:
            if i in vowel:
                second+=1
    return first==second

