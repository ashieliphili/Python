import string
def battle(my_army, opposing_army):
    if len(my_army)<len(opposing_army):
        return "We retreated"
    elif len(my_army)>len(opposing_army):
        return "Opponent retreated"
    def battles(army):
        strings=string.ascii_lowercase+string.ascii_uppercase
        lists=[]
        for char in army:
            if char in strings:
                lists.append(strings.index(char)+1)
            elif char in "0123456789":
                lists.append(int(char))
            else:
                lists.append(0)
        return lists
    my_army_list=battles(my_army)
    opp_army_list=battles(opposing_army)
    my=0
    opp=0
    for i in range(len(my_army_list)):
        if my_army_list[i]>opp_army_list[i]:
            my+=1
        elif my_army_list[i]<opp_army_list[i]:
            opp+=1
        else:
            continue
    if my>opp:
        return "We won"
    elif opp>my:
        return "We lost"
    elif my==opp:
        return "It was a tie"

